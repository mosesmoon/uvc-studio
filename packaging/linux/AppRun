#!/bin/sh
# UVC Studio AppImage entry point.
HERE="$(dirname "$(readlink -f "$0")")"
# VA-API (hardware H.264 encoding) is linked dynamically. Prefer the system's
# libva so its drivers match; fall back to the bundled copy when missing.
have_lib() {
  for d in /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib64 /lib64 /usr/lib /lib; do
    [ -e "$d/$1" ] && return 0
  done
  return 1
}
if ! have_lib libva.so.2 || ! have_lib libva-drm.so.2 || ! have_lib libdrm.so.2; then
  export LD_LIBRARY_PATH="$HERE/usr/lib/fallback${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
exec "$HERE/usr/bin/uvc-studio" "$@"
