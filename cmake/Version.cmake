# Reads ../VERSION and generates version.h:
#   UVC_VERSION_NAME  "1.1.0" (or "1.2.0 Beta 1" when BETA > 0)
#   UVC_VERSION_CODE  major*1000000 + minor*10000 + patch*100 + (BETA ? BETA : 99)
#                     so every Beta sorts before its release and after the
#                     previous version (Android versionCode; up to 1.0 Beta 17
#                     it was major*10000 + minor*100 + BETA).
function(uvc_read_version root out_dir)
  file(STRINGS "${root}/VERSION" lines REGEX "^[A-Z]+=")
  set(ver "0.0")
  set(beta 0)
  foreach(l IN LISTS lines)
    if(l MATCHES "^VERSION=(.+)$")
      set(ver "${CMAKE_MATCH_1}")
    elseif(l MATCHES "^BETA=([0-9]+)$")
      set(beta "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  string(REPLACE "." ";" parts "${ver}")
  list(GET parts 0 major)
  list(LENGTH parts n)
  set(minor 0)
  set(patch 0)
  if(n GREATER 1)
    list(GET parts 1 minor)
  endif()
  if(n GREATER 2)
    list(GET parts 2 patch)
  endif()
  if(beta GREATER 0)
    set(name "${ver} Beta ${beta}")
    set(rcbuild ${beta})
  else()
    set(name "${ver}")
    set(rcbuild 99)
  endif()
  math(EXPR code "${major} * 1000000 + ${minor} * 10000 + ${patch} * 100 + ${rcbuild}")
  file(MAKE_DIRECTORY "${out_dir}")
  file(WRITE "${out_dir}/version.h.tmp"
       "#pragma once\n#define UVC_VERSION_NAME \"${name}\"\n#define UVC_VERSION_CODE ${code}\n#define UVC_VERSION_RC ${major},${minor},${patch},${rcbuild}\n")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${out_dir}/version.h.tmp" "${out_dir}/version.h")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${root}/VERSION")
  set(UVC_VERSION_NAME "${name}" PARENT_SCOPE)
  set(UVC_VERSION_CODE "${code}" PARENT_SCOPE)
  message(STATUS "UVC Studio ${name} (code ${code})")
endfunction()
